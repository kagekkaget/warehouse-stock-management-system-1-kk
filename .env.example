# Contoh konfigurasi environment.
# Salin ke .env (tidak di-commit) dan ganti nilai sesuai lingkungan Anda.
#
# Catatan: parameter `channel_binding` tidak didukung oleh driver `pg` Node.
# Gunakan `uselibpqcompat=true` bila menggunakan Neon/Supabase pooler.
# Contoh: postgresql://pengguna:rahasia@host/neondb?sslmode=require&uselibpqcompat=true
DATABASE_URL="postgresql://contoh:rahasia@127.0.0.1:5432/app_db"